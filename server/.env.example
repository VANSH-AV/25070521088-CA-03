# Runtime
NODE_ENV=development
PORT=5000
# Keep false locally. Behind a reverse proxy, use the exact hop count (for example 1).
TRUST_PROXY=false

# Frontend origins allowed to send credentialed requests.
# Use the exact Vite origins, including ports. Multiple origins are comma-separated.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:4173

# MongoDB
# Use a local MongoDB, Docker, or an Atlas URI. Never commit a real connection string.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=flexi_dev

# Authentication
# Required. Use at least 48 random bytes, for example: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ISSUER=flexi-api
JWT_AUDIENCE=flexi-web
BCRYPT_ROUNDS=12
# Must be true in production; keep false only for local HTTP development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
